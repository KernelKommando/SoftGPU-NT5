[Version]
Signature="$CHICAGO$"
AdvancedINF=2.5,"You must install Internet Explorer 4 or newer"

[DefaultInstall]
BeginPrompt = FirstDialog
DelFiles = DeleteDLLCache, DelNewerFiles
RenFiles = RenameInSystem
UpdateInis = StartMenu
EndPrompt= LastDialog

[FirstDialog]
Title = "Unofficial SoftGPU's WineD3D Install Script"
ButtonType = YESNO
Prompt = "Do you wish to remove SoftGPU's WineD3D Software from your system?"

[LastDialog]
Prompt = "Done."

[SourceDisksNames]
1 = "Unofficial SoftGPU's WineD3D Software INSTALL Cabinet File",install.cab,0

[SourceDisksFiles]



[DestinationDirs]
DeleteDLLCache=11,dllcache
RenameInSystem=11
CopyToDLLCache=11,dllcache


[DeleteDLLCache]
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll

[DelNewerFiles]
wined3d.dll
winedd.dll
wined8.dll
wined9.dll
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll
uninwd3d.inf

[RenameInSystem]
opengl32.dll,opengl32.old
ddraw.dll,ddsys.dll
d3d8.dll,msd3d8.dll
d3d9.dll,msd3d9.dll

[CopyToDLLCache]
; Mesa 3D

[StartMenu]
setup.ini,progman.groups,,"GROUP_SOFTGPU=""SoftGPU's WineD3D"""
setup.ini,GROUP_SOFTGPU,," ""Uninstall"",,,,,,,"


;

