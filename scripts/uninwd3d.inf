[Version]
Signature="$CHICAGO$"
AdvancedINF=2.5,"You must install Internet Explorer 4 or newer"

[DefaultInstall]
BeginPrompt = FirstDialog
DelFiles = DeleteDLLCache, DelNewerFiles
RenFiles = RenameInSystem
DelReg = UninstallEntry
UpdateInis = StartMenu

[LastDialog]
Prompt = "Done."

[SourceDisksNames]
1 = "%InstallerName% Software INSTALL Cabinet File",install.cab,0

[SourceDisksFiles]



[DestinationDirs]
DeleteDLLCache=11,dllcache
RenameInSystem=11
CopyToDLLCache=11,dllcache


[DeleteDLLCache]
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll

[DelNewerFiles]
wined3d.dll
winedd.dll
wined8.dll
wined9.dll
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll
uninwd3d.inf

[RenameInSystem]
opengl32.dll,opengl32.old
ddraw.dll,ddsys.dll
d3d8.dll,msd3d8.dll
d3d9.dll,msd3d9.dll

[CopyToDLLCache]
; Mesa 3D

[StartMenu]
setup.ini,progman.groups,,"GROUP_SOFTGPU=""%StartMenuEntry%"""
setup.ini,GROUP_SOFTGPU,," ""Uninstall"",,,,,,,"

[UninstallEntry]
HKLM,%UninstallKey%\%InstallerName%,"DisplayName"
HKLM,%UninstallKey%\%InstallerName%,"UninstallString"

[Strings]
InstallerName="Unofficial SoftGPU for Windows XP/2000"
StartMenuEntry="SoftGPU"
UninstallKey="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"

;

