[Version]
Signature="$CHICAGO$"
AdvancedINF=2.5,"You must install Internet Explorer 4 or newer"

[DefaultInstall]
DelFiles = DeleteDLLCache, DelNewerFiles
RenFiles = RenameInSystem
DelReg = CompatibilityEntries, UninstallEntry
UpdateInis = StartMenu

[SourceDisksNames]
1 = "%InstallerName% Software INSTALL Cabinet File",install.cab,0

[DestinationDirs]
DeleteDLLCache=11,dllcache
RenameInSystem=11

[DeleteDLLCache]
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll

[DelNewerFiles]
wined3d.dll
winedd.dll
wined8.dll
wined9.dll
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll
uninwd3d.inf

[RenameInSystem]
opengl32.dll,opengl32.old
ddraw.dll,ddsys.dll
d3d8.dll,msd3d8.dll
d3d9.dll,msd3d9.dll

[StartMenu]
setup.ini,progman.groups,,"GROUP_SOFTGPU=""%StartMenuEntry%"""
setup.ini,GROUP_SOFTGPU,," ""Uninstall"",,,,,,,"

[CompatibilityEntries]
HKLM,%Mesa3D%
HKLM,%DDSwitcher%
HKLM,%D8Switcher%
HKLM,%D9Switcher%

[UninstallEntry]
HKLM,%UninstallKey%\%InstallerName%

[Strings]
InstallerName="Unofficial SoftGPU for Windows XP/2000"
StartMenuEntry="SoftGPU"
UninstallKey="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"
Mesa3D="SOFTWARE\Mesa3D"
DDSwitcher="SOFTWARE\DDSwitcher"
D8Switcher="SOFTWARE\D8Switcher"
D9Switcher="SOFTWARE\D9Switcher"
;
