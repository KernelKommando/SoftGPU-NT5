[Version]
Signature="$CHICAGO$"
AdvancedINF=2.5,"You must install Internet Explorer 4 or newer"

[DefaultInstall]
DelFiles = DeleteDLLCache
RenFiles = RenameInSystem
CopyFiles = CopyToDLLCache,CopyToSystem
AddReg = CompatibilityEntries, UninstallEntry
UpdateInis = StartMenu

[SourceDisksNames]
1 = "%InstallerName% Software INSTALL Cabinet File",install.cab,0

[SourceDisksFiles]
; SoftGPU Virtual Display driver
vmdisp9x.dll = 1

; Mesa 3D
opengl32.dll = 1

; WineD3D d3dX replacements
ddraw_xp.dll = 1
d3d8_xp.dll = 1
d3d9_xp.dll = 1

; WineD3D Core files
wined3d.dll = 1
winedd.dll = 1
wined8.dll = 1
wined9.dll = 1

; Uninstall Script
uninwd3d.inf = 1


[DestinationDirs]
DeleteDLLCache=11,dllcache
RenameInSystem=11
CopyToDLLCache=11,dllcache
CopyToSystem=11


[DeleteDLLCache]
opengl32.dll
ddraw.dll
d3d8.dll
d3d9.dll



[RenameInSystem]
opengl32.old,opengl32.dll
ddsys.dll,ddraw.dll
msd3d8.dll,d3d8.dll
msd3d9.dll,d3d9.dll



[CopyToDLLCache]
; Mesa 3D
opengl32.dll,,,4

; WineD3D d3dX replacements
ddraw.dll,ddraw_xp.dll,,4
d3d8.dll,d3d8_xp.dll,,4
d3d9.dll,d3d9_xp.dll,,4



[CopyToSystem]
; SoftGPU Virtual Display driver
vmdisp9x.dll,,,4

; Mesa 3D
opengl32.dll,,,4

; WineD3D d3dX replacements
ddraw.dll,ddraw_xp.dll,,4
d3d8.dll,d3d8_xp.dll,,4
d3d9.dll,d3d9_xp.dll,,4

; WineD3D Core files
wined3d.dll,,,4
winedd.dll,,,4
wined8.dll,,,4
wined9.dll,,,4

; Uninstall Script
uninwd3d.inf,,,4


[StartMenu]
setup.ini,progman.groups,,"GROUP_SOFTGPU=""%StartMenuEntry%"""
setup.ini,GROUP_SOFTGPU,," ""Uninstall"", ""%AdvPackCommand% %windir%\system32\uninwd3d.inf,,,N"",""%11%\SHELL32.DLL"",102,,""%WINDIR%"" " 

[CompatibilityEntries]
; Default SoftGPU Mesa3D Entries
HKLM,"%Mesa3D%\glquake.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\quake2.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\sin.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\Heretic2.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\glh2.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\Oni.exe","MESA_EXTENSION_MAX_YEAR",,"2001"
HKLM,"%Mesa3D%\xtremecr.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\litecr.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\SoF.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\quake3.exe","MESA_EXTENSION_MAX_YEAR",,"2006"
HKLM,"%Mesa3D%\wolfmp.exe","MESA_EXTENSION_MAX_YEAR",,"2006"
HKLM,"%Mesa3D%\wolfsp.exe","MESA_EXTENSION_MAX_YEAR",,"2006"
HKLM,"%Mesa3D%\sof2.exe","MESA_EXTENSION_MAX_YEAR",,"2004"
HKLM,"%Mesa3D%\jk2mp.exe","MESA_EXTENSION_MAX_YEAR",,"2006"
HKLM,"%Mesa3D%\jk2sp.exe","MESA_EXTENSION_MAX_YEAR",,"2006"
; Addtional Mesa3D Entries
HKLM,"%Mesa3D%\q2test.exe","MESA_EXTENSION_MAX_YEAR",,"2004"

; Default SoftGPU WineDirectDraw Entries
HKLM,%DDSwitcher%,"Oni.exe",,"system"
HKLM,%DDSwitcher%,"hl.exe",,"system"
HKLM,%DDSwitcher%,"diablo.exe",,"system"
HKLM,%DDSwitcher%,"mdk95.exe",,"system"
HKLM,%DDSwitcher%,"isle.exe",,"system"
HKLM,%DDSwitcher%,"legoisle.exe",,"system"
HKLM,%DDSwitcher%,"mib.exe",,"system"
HKLM,%DDSwitcher%,"Sims.exe",,"system"
HKLM,%DDSwitcher%,"rct.exe",,"system"
HKLM,%DDSwitcher%,"MPLAYER.exe",,"system"
HKLM,%DDSwitcher%,"MPLAYER2.exe",,"system"
HKLM,%DDSwitcher%,"wmplayer.exe",,"system"
HKLM,%DDSwitcher%,"DivX Player 2.1.exe",,"system"
HKLM,%DDSwitcher%,"PowerDVD.exe",,"system"
HKLM,%DDSwitcher%,"winamp.exe",,"system"
HKLM,%DDSwitcher%,"Carm95.exe",,"system"
HKLM,%DDSwitcher%,"HCopter.exe",,"system"
HKLM,%DDSwitcher%,"aow.exe",,"system"
HKLM,%DDSwitcher%,"empires.exe",,"system"
HKLM,%DDSwitcher%,"heroes3.exe",,"system"
HKLM,%DDSwitcher%,"lithtech.exe",,"wine"
HKLM,%DDSwitcher%,"td6.exe",,"wine"
; Additional WineDirectDraw Entries
HKLM,%DDSwitcher%,"dxdiag.exe",,"system"

; To be added in the future:
; - Hitman (Glide)
; - u9.icd (Glide)
; - Swep1rcr.exe
; - Quake3 (Glide)

HKLM,%D8Switcher%
HKLM,%D9Switcher%

[UninstallEntry]
HKLM,%UninstallKey%\%InstallerName%,"DisplayName",,"%InstallerName%"
HKLM,%UninstallKey%\%InstallerName%,"UninstallString",,"%AdvPackCommand% %10%\system32\uninwd3d.inf,,,N"

[Strings]
InstallerName="Unofficial SoftGPU for Windows XP/2000"
StartMenuEntry="SoftGPU"
AdvPackCommand="rundll32.exe advpack.dll,LaunchINFSection "
UninstallKey="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"
Mesa3D="SOFTWARE\Mesa3D"
DDSwitcher="SOFTWARE\DDSwitcher"
D8Switcher="SOFTWARE\D8Switcher"
D9Switcher="SOFTWARE\D9Switcher"
;
